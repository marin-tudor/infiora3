# Application
ASPNETCORE_ENVIRONMENT=Development

# Database
DATABASE_PROVIDER=PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=infioradb
POSTGRES_USER=infiora
